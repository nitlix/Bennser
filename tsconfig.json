{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"lib": ["ES2022", "DOM"],
		"noEmit": true
	},
	"include": ["packages/*/src", "tests"]
}
