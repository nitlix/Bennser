{
	"name": "bennser-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "bun run --cwd apps/web dev",
		"sync": "bun scripts/sync-upstream.ts",
		"build:asm": "bun packages/asm/build.ts",
		"build:oracle": "bun tests/build-oracle.ts",
		"build:favicon": "bun scripts/build-favicon.ts",
		"test": "bun test tests/",
		"typecheck": "tsc --noEmit -p ."
	},
	"devDependencies": {
		"@bennser/asm": "workspace:*",
		"@bennser/core": "workspace:*",
		"@types/bun": "latest",
		"typescript": "^5.9.0"
	}
}
